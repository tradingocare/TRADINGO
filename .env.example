# =============================================================================
# TRADINGO — Environment Variables
# =============================================================================

# ─── Feature Flags (Sprint 2) ────────────────────────────────────────────
FEATURE_REFERRAL_UI=false
FEATURE_TRACKING=true
FEATURE_GA4=false
FEATURE_PUBLIC_CRM=true
FEATURE_LEAD_CAPTURE=false
FEATURE_SHARE_LINKS=false

# ─── GA4 (Tracking) ─────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ─── Cloudflare Turnstile (Public CRM) ───────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ─── Application ──────────────────────────────────────────────────────────
APP_NAME=tradingo
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://tradingo:secret123@localhost:5432/tradingo?schema=public
DIRECT_URL=postgresql://tradingo:secret123@localhost:5432/tradingo?schema=public
SHADOW_DATABASE_URL=postgresql://tradingo:secret123@localhost:5432/tradingo_shadow?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AWS (S3 + CloudFront + SES) ───────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=tradingo-uploads
CLOUDFRONT_DOMAIN=d1234.cloudfront.net
EMAIL_FROM=noreply@tradingo.io

# ─── OpenSearch ────────────────────────────────────────────────────────────
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_REJECT_UNAUTHORIZED=true

# ─── ClickHouse ────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ─── Sentry ────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENABLED=false

# ─── Slack (Notifications) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── SMTP (Email) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# ─── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── LinkedIn OAuth ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ─── Google Maps ───────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Next.js (Frontend) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001        # WebSocket URL (same as API in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=                              # Public Sentry DSN (falls back to SENTRY_DSN)
NEXT_PUBLIC_APP_VERSION=v1.0.0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_CDN_URL=                                 # CDN URL for static assets (optional)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ─── Web (Server-side) ────────────────────────────────────────────────────
JWKS_URL=                                            # JWKS endpoint (optional — falls back to HS256)
GA_ID=                                               # Google Analytics ID (optional)

# ─── Razorpay (Payments) ──────────────────────────────────────────────────
PAYMENT_MODE=test                                   # test | live
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ACCOUNT_NUMBER=                            # Razorpay account number for payouts (optional)

# ─── Stripe (Payments — optional) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Seed Admin ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@tradingo.io
SEED_ADMIN_PASSWORD=Admin@1234

# ─── AI Gateway ─────────────────────────────────────────────────────────────
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_VAULT_MASTER_KEY=change-me-to-a-64-char-random-string-for-production

# ─── AI Providers — API Keys ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (Primary AI Provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Groq (Fast Inference)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Tavily (Live Search)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Firecrawl (Website Import)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================

# ─── PostgreSQL PITR / WAL ────────────────────────────────────────────────────
PG_DATABASE=tradingo
PG_HOST=localhost
PG_PORT=5432
PG_USER=tradingo
PG_PASSWORD=secret123
PG_TEST_DATABASE=tradingo_restore_test   # Used by weekly restore test

# ─── Backup Retention ──────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30                   # Local and S3 STANDARD_IA retention
BACKUP_LOG_DIR=/var/log/tradingo/backups   # Backup agent log directory
WAL_RETENTION_HOURS=168                    # WAL segments retained (7 days)

# ─── S3 Backup Bucket (separate from app upload bucket) ────────────────────────
S3_BACKUP_BUCKET=tradingo-backups
S3_BACKUP_PREFIX=postgres                  # Object key prefix for backup files

# ─── Disaster Recovery ─────────────────────────────────────────────────────────
PRIMARY_REGION=ap-south-1                  # Primary AWS region
DR_REGION=eu-west-1                        # DR region (cross-region failover)
PRIMARY_LB_ZONE_ID=                        # Route53 zone ID for primary ALB
PRIMARY_LB_DNS=                            # Primary ALB DNS name
DR_LB_ZONE_ID=                             # Route53 zone ID for DR ALB
DR_LB_DNS=                                 # DR ALB DNS name
