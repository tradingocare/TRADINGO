# ============================================
# TRADINGO — Production Environment Variables
# ============================================
# Copy this to .env and fill in all values.

# ── App ──
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://tradingo.in
API_URL=https://api.tradingo.in
LOG_LEVEL=info

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=https://api.tradingo.in/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.tradingo.in
NEXT_PUBLIC_SITE_URL=https://tradingo.in
NEXT_PUBLIC_APP_URL=https://tradingo.in
# REQUIRED: Replace with your live Razorpay key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=v1.0.0
NEXT_PUBLIC_APP_ENV=production

# ── Database ──
# REQUIRED: Generate a strong random password (openssl rand -base64 32)
DATABASE_URL=postgresql://tradingo:YOUR_DATABASE_PASSWORD@postgres:5432/tradingo
DIRECT_URL=postgresql://tradingo:YOUR_DATABASE_PASSWORD@localhost:5432/tradingo
# REQUIRED: Must match DATABASE_URL password above
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD

# ── Redis ──
# REQUIRED: Generate a strong random password (openssl rand -base64 32)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ── JWT ──
# REQUIRED: Generate with: openssl rand -hex 64
JWT_SECRET=YOUR_JWT_SECRET_HERE
# REQUIRED: Generate with: openssl rand -hex 64
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS ──
AWS_REGION=ap-south-1
# REQUIRED: Set your IAM user access key with SES+S3 permissions
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# REQUIRED: Set your IAM user secret key with SES+S3 permissions
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_BUCKET=tradingo-uploads
CLOUDFRONT_DOMAIN=

# ── OpenSearch ──
OPENSEARCH_URL=http://host.docker.internal:9200
# REQUIRED: OpenSearch username for search indexing
OPENSEARCH_USERNAME=YOUR_OPENSEARCH_USERNAME
# REQUIRED: OpenSearch password for search indexing
OPENSEARCH_PASSWORD=YOUR_OPENSEARCH_PASSWORD

# ── ClickHouse ──
CLICKHOUSE_URL=http://host.docker.internal:8123
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# ── SES Email ──
# REQUIRED: Verified SES sending domain/email address
EMAIL_FROM=noreply@tradingotech.com

# ── NOT USED: Email delivery is via AWS SES (not SMTP) ──
# SMTP_HOST / SMTP_USER / SMTP_PASS are not read by any code.
# Set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for SES instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.tradingo.in/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://api.tradingo.in/auth/linkedin/callback

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=

# ── Twilio SMS ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_PROVIDER=twilio

# ── Razorpay ──
# REQUIRED: Replace with your live Razorpay keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
RAZORPAY_ACCOUNT_NUMBER=
PAYMENT_MODE=live

# ── Stripe ──
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Sentry ──
# REQUIRED: Set your Sentry DSN for error monitoring. Set SENTRY_ENABLED=false if not using Sentry.
SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_ENABLED=true

# ── AI Vault ──
# REQUIRED: Generate with: openssl rand -hex 64
AI_VAULT_MASTER_KEY=YOUR_AI_VAULT_MASTER_KEY_HERE
AI_CACHE_ENABLED=true

# ── AI Provider Keys ──
# At least one AI provider key is required for AI features to work
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY

# ── Backup ──
S3_BACKUP_BUCKET=tradingo-backups
S3_BACKUP_PREFIX=postgres
BACKUP_RETENTION_DAYS=30
# REQUIRED: Must match DATABASE_URL password above
PG_PASSWORD=YOUR_DATABASE_PASSWORD
WAL_BACKUP_BUCKET=tradingo-wal-archive
WAL_RETENTION_HOURS=168

# ── Monitoring ──
# REQUIRED: Generate a strong password (openssl rand -base64 24)
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD_HERE
SLACK_WEBHOOK_URL=
