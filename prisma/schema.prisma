}

model EnterpriseSearchAnalytics {
  id          String   @id @default(uuid())
  companyId   String?
  userId      String?
  query       String
  entityType  String
  resultCount Int      @default(0)
  zeroResults Boolean  @default(false)
  filters     Json?
  suggestions String[]
  latencyMs   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([entityType])
  @@index([createdAt])
  @@index([zeroResults])
  @@index([companyId])
  @@index([createdAt, entityType])
}

model EnterpriseSearchTrending {
  id         String   @id @default(uuid())
  query      String
  entityType String   @default("all")
  count      Int      @default(1)
  period     String   @default("daily")
  periodKey  String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([query, entityType, period, periodKey])
  @@index([count])
  @@index([period, periodKey])
}

model CrmCampaign {
  id             String            @id @default(uuid())
  name           String
  description    String?
  type           CrmCampaignType   @default(OTHER)
  status         CrmCampaignStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  budget         Decimal?          @db.Decimal(12, 2)
  targetLeads    Int               @default(0)
  reachedLeads   Int               @default(0)
  convertedLeads Int               @default(0)
  metadata       Json?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  leads          CrmLead[]

  @@index([type])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdBy])
}

model NewsletterSubscriber {
  id             String                     @id @default(uuid())
  email          String                     @unique
  name           String?
  companyId      String?
  status         NewsletterSubscriberStatus @default(ACTIVE)
  subscribedAt   DateTime                   @default(now())
  unsubscribedAt DateTime?
  metadata       Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status])
  @@index([companyId])
}

model NewsletterCampaign {
  id          String                   @id @default(uuid())
  name        String
  subject     String
  body        String
  template    String?
  status      NewsletterCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int                      @default(0)
  openCount   Int                      @default(0)
  clickCount  Int                      @default(0)
  bounceCount Int                      @default(0)
  metadata    Json?
  createdBy   String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([createdBy])
}

model MarketingWorkflow {
  id          String                   @id @default(uuid())
  name        String
  description String?
  trigger     MarketingWorkflowTrigger
  conditions  Json?
  actions     Json
  status      MarketingWorkflowStatus  @default(ACTIVE)
  runCount    Int                      @default(0)
  lastRunAt   DateTime?
  createdBy   String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  logs        MarketingWorkflowLog[]

  @@index([trigger])
  @@index([status])
  @@index([createdBy])
}

model MarketingWorkflowLog {
  id         String            @id @default(uuid())
  workflowId String
  triggerId  String?
  status     String
  result     String?
  executedAt DateTime          @default(now())
  workflow   MarketingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([triggerId])
  @@index([status])
  @@index([executedAt])
}

