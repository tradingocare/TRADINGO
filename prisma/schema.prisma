generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GOCASH_Wallet {
  id               String               @id @default(uuid())
  userId           String               @unique
  companyId        String?
  type             GOCASHWalletType
  currentBalance   Decimal              @default(0) @db.Decimal(10, 2)
  availableBalance Decimal              @default(0) @db.Decimal(10, 2)
  pendingBalance   Decimal              @default(0) @db.Decimal(10, 2)
  lockedBalance    Decimal              @default(0) @db.Decimal(10, 2)
  expiredBalance   Decimal              @default(0) @db.Decimal(10, 2)
  lifetimeEarned   Decimal              @default(0) @db.Decimal(10, 2)
  lifetimeRedeemed Decimal              @default(0) @db.Decimal(10, 2)
  lifetimeExpired  Decimal              @default(0) @db.Decimal(10, 2)
  phoneNumber      String?
  kycVerified      Boolean              @default(false)
  status           GOCASHWalletStatus   @default(ACTIVE)
  lockedUntil      DateTime?
  createdAt        DateTime             @default(now())
  redemptions      GOCASH_Redemption[]
  transactions     GOCASH_Transaction[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model GOCASH_Transaction {
  id             String                @id @default(uuid())
  walletId       String
  direction      GOCASHLedgerDirection
  status         GOCASHLedgerStatus    @default(SUCCESS)
  type           GOCASHTransactionType
  amount         Decimal               @db.Decimal(10, 2)
  balanceBefore  Decimal               @db.Decimal(10, 2)
  balanceAfter   Decimal               @db.Decimal(10, 2)
  currency       String                @default("GOCASH")
  reference      String?
  referenceType  String?
  referenceId    String?
  sourceType     String?
  sourceSystem   String?
  idempotencyKey String?               @unique
  reason         String
  notes          String?
  actorId        String
  actorType      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  wallet         GOCASH_Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@index([direction])
  @@index([status])
  @@index([idempotencyKey])
  @@index([referenceId])
  @@index([walletId, createdAt])
}

model RewardCampaign {
  id              String                @id @default(uuid())
  name            String
  description     String?
  type            GOCASH_CampaignType
  startDate       DateTime
  endDate         DateTime
  budget          Decimal               @default(0) @db.Decimal(10, 2)
  remainingBudget Decimal               @db.Decimal(10, 2)
  requirement     String?
  rewardAmount    Decimal               @db.Decimal(10, 2)
  rewardType      String
  maxClaims       Int                   @default(0)
  claimedCount    Int                   @default(0)
  status          GOCASH_CampaignStatus @default(ACTIVE)
  companyId       String?
  createdBy       String

  @@index([type])
  @@index([status])
  @@index([endDate])
  @@index([companyId])
}

model ReferralProgram {
  id             String                @id @default(uuid())
  companyId      String
  name           String
  description    String?
  referralCode   String                @unique
  rewardAmount   Decimal               @default(0) @db.Decimal(10, 2)
  commissionRate Decimal               @default(0) @db.Decimal(5, 2)
  status         GOCASH_ReferralStatus @default(ACTIVE)
  maxReferrals   Int                   @default(0)
  usedCount      Int                   @default(0)
  createdBy      String

  @@index([companyId])
  @@index([referralCode])
  @@index([status])
}

model ReferralCode {
  id           String             @id @default(uuid())
  code         String             @unique
  userId       String
  companyId    String?
  type         ReferralCodeType
  status       ReferralCodeStatus @default(ACTIVE)
  rewardAmount Decimal?           @db.Decimal(10, 2)
  rewardType   String?
  maxUsage     Int                @default(0)
  currentUsage Int                @default(0)
  expiresAt    DateTime?
  metadata     Json?
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  usages       ReferralUsage[]

  @@index([userId])
  @@index([code])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
}

model ReferralUsage {
  id             String              @id @default(uuid())
  codeId         String
  referrerUserId String
  refereeUserId  String?
  refereeEmail   String
  status         ReferralUsageStatus @default(PENDING)
  source         String?
  ipAddress      String?
  userAgent      String?
  deviceId       String?
  metadata       Json?
  referredAt     DateTime            @default(now())
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  rewards        ReferralReward[]
  code           ReferralCode        @relation(fields: [codeId], references: [id])

  @@index([codeId])
  @@index([referrerUserId])
  @@index([refereeEmail])
  @@index([status])
  @@index([ipAddress])
  @@index([deviceId])
  @@index([referredAt])
}

model ReferralReward {
  id             String               @id @default(uuid())
  usageId        String
  referrerUserId String
  refereeUserId  String?
  amount         Decimal              @db.Decimal(10, 2)
  type           String
  status         ReferralRewardStatus @default(PENDING)
  transactionId  String?
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  usage          ReferralUsage        @relation(fields: [usageId], references: [id])

  @@index([usageId])
  @@index([referrerUserId])
  @@index([status])
  @@index([transactionId])
}

model ReferralAudit {
  id        String   @id @default(uuid())
  usageId   String?
  action    String
  details   String?
  ipAddress String?
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([usageId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

model ReferralRule {
  id             String                @id @default(uuid())
  name           String
  description    String?
  type           String
  referrerReward Decimal               @db.Decimal(10, 2)
  refereeReward  Decimal?              @db.Decimal(10, 2)
  rewardType     String
  minAmount      Decimal?              @db.Decimal(10, 2)
  maxAmount      Decimal?              @db.Decimal(10, 2)
  conditions     Json?
  status         GOCASH_ReferralStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?
  createdBy      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([type])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ReferralBlacklist {
  id        String                @id @default(uuid())
  type      ReferralBlacklistType
  value     String
  reason    String?
  createdBy String
  expiresAt DateTime?
  createdAt DateTime              @default(now())

  @@index([type])
  @@index([value])
  @@index([expiresAt])
}

model GOCASH_Redemption {
  id              String                  @id @default(uuid())
  walletId        String
  amount          Decimal                 @db.Decimal(10, 2)
  redemptionType  GOCASH_RedemptionType
  status          GOCASH_RedemptionStatus @default(PENDING)
  reference       String?
  redeemedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedBy      String?
  createdAt       DateTime                @default(now())
  wallet          GOCASH_Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model User {
  id                          String                    @id @default(uuid())
  email                       String                    @unique
  mobile                      String?
  panNumber                   String?                   @unique
  passwordHash                String
  name                        String
  role                        Role                      @default(VIEWER)
  status                      String                    @default("active")
  permissions                 String[]                  @default([])
  isActive                    Boolean                   @default(true)
  emailVerifiedAt             DateTime?
  mobileVerifiedAt            DateTime?
  verificationLevel           VerificationLevel         @default(LEVEL_0)
  provider                    String?
  providerId                  String?
  deletedAt                   DateTime?
  loginAttempts               Int                       @default(0)
  lockedUntil                 DateTime?
  rmCode                      String?                   @unique
  meCode                      String?                   @unique
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  auditLogs                   AuditLog[]
  meAttributions              CodeAttribution[]         @relation("MEAttributions")
  rmAttributions              CodeAttribution[]         @relation("RMAttributions")
  communitiesOwned            Community[]
  invitationsSent             CommunityInvitation[]
  membersInvited              CommunityMember[]         @relation("CommunityInvitedBy")
  communityMemberships        CommunityMember[]
  managedCompanies            Company[]                 @relation("RMManagedCompanies")
  rmCertificationReviews      CompanyCertification[]    @relation("CertificationReviews")
  ownedCompanies              CompanyOwner[]
  verificationReviews         CompanyVerification[]     @relation("VerificationReviews")
  companyVerifications        CompanyVerification[]     @relation("CompanyVerifications")
  chatParticipants            ConversationParticipant[]
  crmLeads                    CrmLead[]                 @relation("CrmLeadOwner")
  disputeMessages             DisputeMessage[]
  verifiedPaymentProofs       ManualPaymentProof[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  organizationInvitationsSent OrganizationInvitation[]  @relation("InvitationsSent")
  organizationMembers         OrganizationMember[]
  productApprovals            ProductApproval[]
  professionalSavedSearches   ProfessionalSavedSearch[]
  quotesSubmitted             Quote[]                   @relation("QuoteCreators")
  reportedMessages            ReportedMessage[]         @relation("ReportedBy")
  reviewedReports             ReportedMessage[]         @relation("ReviewedBy")
  reputationEvents            ReputationEvent[]
  rfqsCreated                 Rfq[]                     @relation("RfqCreators")
  sessions                    Session[]
  followers                   SocialFollow[]            @relation("FollowedBy")
  socialPosts                 SocialPost[]
  socialPostLikes             SocialPostLike[]
  socialSavedPosts            SocialSavedPost[]
  assignedTickets             SupportTicket[]           @relation("AssignedTickets")
  supportTickets              SupportTicket[]
  supportTicketMessages       SupportTicketMessage[]
  userVerificationReviews     UserVerification[]        @relation("UserVerificationReviews")
  userVerificationSubmissions UserVerification[]        @relation("UserVerificationSubmitter")
  userVerifications           UserVerification[]        @relation("UserVerificationUser")

  @@unique([provider, providerId])
  @@index([status])
  @@index([role, isActive])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  deviceInfo   String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([isActive])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resource      String
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  companyId     String?
  correlationId String?
  newValue      Json?
  outcome       String?
  previousValue Json?
  sessionId     String?
  userAgent     String?
  company       Company? @relation(fields: [companyId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([resource])
  @@index([correlationId])
  @@index([createdAt])
  @@index([outcome])
}

model Organization {
  id          String                   @id @default(uuid())
  name        String
  slug        String                   @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  companies   Company[]
  invitations OrganizationInvitation[]
  members     OrganizationMember[]

  @@index([slug])
  @@index([deletedAt])
}

model OrganizationMember {
  id             String        @id @default(uuid())
  organizationId String
  userId         String
  role           OrgMemberRole @default(MEMBER)
  invitedBy      String?
  joinedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrgMemberRole    @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedBy      String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  inviter        User             @relation("InvitationsSent", fields: [invitedBy], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@index([email])
}

model Category {
  id                       String                    @id @default(uuid())
  parentId                 String?
  name                     String
  slug                     String                    @unique
  description              String?
  icon                     String?
  image                    String?
  seoTitle                 String?
  seoDescription           String?
  isActive                 Boolean                   @default(true)
  sortOrder                Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  attributeTemplates       AttributeTemplate[]
  parent                   Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children                 Category[]                @relation("CategoryTree")
  categoryGlobalAttributes CategoryGlobalAttribute[]
  templates                CategoryTemplate[]
  companies                CompanyCategory[]
  industryMappings         IndustryCategoryMapping[]
  products                 Product[]
  productDrafts            ProductDraft[]
  productLocationIndexes   ProductLocationIndex[]
  productMasters           ProductMaster[]
  rfqs                     Rfq[]
  rfqProductItems          RfqProductItem[]
  serviceMasters           ServiceMaster[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model Industry {
  id               String                    @id @default(uuid())
  name             String                    @unique
  slug             String                    @unique
  description      String?
  icon             String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  companies        CompanyIndustry[]
  categoryMappings IndustryCategoryMapping[]
  industryRooms    IndustryRoom[]
  products         Product[]
  rfqs             Rfq[]

  @@index([slug])
}

model Company {
  id                          String                      @id @default(uuid())
  organizationId              String?
  name                        String
  slug                        String                      @unique
  logo                        String?
  banner                      String?
  description                 String?
  businessType                BusinessType?
  establishedYear             Int?
  employeeCount               Int?
  gstNumber                   String?
  panNumber                   String?
  website                     String?
  email                       String?
  mobile                      String?
  trustScore                  Int                         @default(0)
  verificationLevel           VerificationLevel           @default(LEVEL_0)
  geographicReach             GeographicReach?
  status                      CompanyStatus               @default(ACTIVE)
  totalProducts               Int                         @default(0)
  responseRate                Float                       @default(0)
  vendorCode                  String?                     @unique
  onboardedByCode             String?
  subscriptionStatus          SubscriptionStatus          @default(TRIAL)
  subscriptionPlan            PlanType?
  subscriptionActivatedAt     DateTime?
  subscriptionExpiresAt       DateTime?
  subscriptionGraceStart      DateTime?
  currentPlanId               String?
  goCashBalance               Int                         @default(0)
  certifications              Json?
  gallery                     Json?
  maxSampleProducts           Int                         @default(5)
  profileCompletionPercentage Int                         @default(0)
  onboardingStatus            OnboardingStep?
  onboardingStartedAt         DateTime?
  onboardingCompletedAt       DateTime?
  assignedRmId                String?
  assignedAt                  DateTime?
  referralRewardedAt          DateTime?
  professionalType            ProfessionalType?
  professionalStatus          ProfessionalCompanyStatus?
  professionalApprovedAt      DateTime?
  professionalRejectedAt      DateTime?
  professionalRejectedReason  String?
  professionalReviewedBy      String?
  responseTimeMinutes         Int?
  lastActiveAt                DateTime?
  videoIntroductionUrl        String?
  socialLinks                 Json?
  businessHours               Json?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  deletedAt                   DateTime?
  createdBy                   String
  updatedBy                   String?
  advertisements              Advertisement[]
  aiCreditUsage               AiCreditUsage[]
  auditLogs                   AuditLog[]
  bookingsAsClient            Booking[]                   @relation("ClientBookings")
  bookingsAsProfessional      Booking[]                   @relation("ProfessionalBookings")
  buyerCredit                 BuyerCredit?
  collectionNotes             CollectionNote[]
  collectionTimeline          CollectionTimelineEvent[]
  communities                 Community[]
  communityMembers            CommunityMember[]
  assignedRm                  User?                       @relation("RMManagedCompanies", fields: [assignedRmId], references: [id])
  currentPlan                 MembershipPlan?             @relation("CurrentPlan", fields: [currentPlanId], references: [planId])
  organization                Organization?               @relation(fields: [organizationId], references: [id])
  categories                  CompanyCategory[]
  certificationDocs           CompanyCertification[]
  galleryImages               CompanyGalleryImage[]
  industries                  CompanyIndustry[]
  locations                   CompanyLocation[]
  onboardingLogs              CompanyOnboardingLog[]
  owners                      CompanyOwner[]
  verifications               CompanyVerification[]
  conversationLabels          ConversationLabel[]
  chatParticipants            ConversationParticipant[]
  couponRedemptions           CouponRedemption[]
  creditNotes                 CreditNote[]
  crmLeads                    CrmLead[]                   @relation("CrmLeadCompany")
  debitNotes                  DebitNote[]
  buyerDeliveries             Delivery[]                  @relation("DeliveryBuyer")
  sellerDeliveries            Delivery[]                  @relation("DeliverySeller")
  disputesAgainst             Dispute[]                   @relation("DisputeAgainst")
  disputesRaised              Dispute[]                   @relation("DisputeRaisedBy")
  escrowsAsBuyer              Escrow[]                    @relation("EscrowBuyer")
  escrowsAsSeller             Escrow[]                    @relation("EscrowSeller")
  fileScans                   FileScan[]
  goCashTransactions          GoCashTransaction[]
  invoices                    Invoice[]
  manualPaymentProofs         ManualPaymentProof[]
  mediaFolders                MediaFolder[]
  buyerNegotiations           Negotiation[]               @relation("BuyerNegotiations")
  sellerNegotiations          Negotiation[]               @relation("SellerNegotiations")
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  buyerOrders                 Order[]                     @relation("OrderBuyer")
  sellerOrders                Order[]                     @relation("OrderSeller")
  payments                    Payment[]
  payouts                     Payout[]
  planHistory                 PlanHistory[]
  products                    Product[]
  productBrands               ProductBrand[]
  productClaims               ProductClaim[]
  productDrafts               ProductDraft[]
  productExportJobs           ProductExportJob[]
  productLocationIndexes      ProductLocationIndex[]
  qa                          ProductQa[]
  reviews                     ProductReview[]
  professionalAvailability    ProfessionalAvailability[]
  professionalCertifications  ProfessionalCertification[]
  inquiries                   ProfessionalInquiry[]
  professionalLanguages       ProfessionalLanguage[]
  professionalPortfolio       ProfessionalPortfolio[]
  reviewsAsClient             ProfessionalReview[]        @relation("ClientReviews")
  reviewsAsProfessional       ProfessionalReview[]        @relation("ProfessionalReviews")
  professionalServices        ProfessionalService[]
  professionalServiceAreas    ProfessionalServiceArea[]
  proposalsAsClient           Proposal[]                  @relation("ClientProposals")
  proposalsAsProfessional     Proposal[]                  @relation("ProfessionalProposals")
  buyerPos                    PurchaseOrder[]             @relation("BuyerPurchaseOrders")
  sellerPos                   PurchaseOrder[]             @relation("SellerPurchaseOrders")
  quotesSubmitted             Quote[]                     @relation("SellerQuotes")
  referralsReceived           Referral[]                  @relation("ReferralsReceived")
  referralsGiven              Referral[]                  @relation("ReferralsGiven")
  rfqsCreated                 Rfq[]                       @relation("BuyerRfqs")
  rfqAnalytics                RfqAnalytics?
  rfqAnalyticsEvents          RfqAnalyticsEvent[]
  rfqCreditLedgers            RfqCreditLedger[]
  rfqCreditPacks              RfqCreditPack[]
  rfqMatches                  RfqVendorMatch[]            @relation("MatchedSellers")
  savedBySuppliers            SavedSupplier[]
  savedTemplates              SavedTemplate[]
  analyticsEvents             SellerAnalyticsEvent[]
  payoutAccounts              SellerPayoutAccount?
  buyerShipments              Shipment[]                  @relation("ShipmentBuyer")
  sellerShipments             Shipment[]                  @relation("ShipmentSeller")
  socialPosts                 SocialPost[]
  subscriptionEvents          SubscriptionEvent[]
  supportTickets              SupportTicket[]
  tradTrustScores             TradTrustScore[]

  @@index([slug])
  @@index([organizationId])
  @@index([status])
  @@index([businessType])
  @@index([trustScore])
  @@index([vendorCode])
  @@index([assignedRmId])
  @@index([deletedAt])
  @@index([professionalType])
  @@index([professionalStatus])
  @@index([professionalType, professionalStatus])
}

model ProfessionalService {
  id            String       @id @default(uuid())
  companyId     String
  name          String
  description   String?
  category      String?
  priceMin      Decimal?     @db.Decimal(12, 2)
  priceMax      Decimal?     @db.Decimal(12, 2)
  pricingType   String?
  deliveryDays  Int?
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  catalogItemId String?
  bookings      Booking[]
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([catalogItemId])
  @@index([category])
  @@index([isActive])
  @@index([companyId, isActive])
}

model ProfessionalPortfolio {
  id             String    @id @default(uuid())
  companyId      String
  title          String
  description    String?
  clientName     String?
  completionDate DateTime?
  media          Json?
  tags           String[]
  isFeatured     Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isFeatured])
}

model ProfessionalCertification {
  id                 String             @id @default(uuid())
  companyId          String
  name               String
  issuingAuthority   String
  issueDate          DateTime
  expiryDate         DateTime?
  certificateUrl     String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([verificationStatus])
  @@index([companyId, verificationStatus])
}

model ProfessionalAvailability {
  id          String   @id @default(uuid())
  companyId   String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

model ProfessionalLanguage {
  id          String   @id @default(uuid())
  companyId   String
  language    String
  proficiency String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, language])
  @@index([companyId])
}

model ProfessionalServiceArea {
  id          String   @id @default(uuid())
  companyId   String
  city        String
  state       String?
  country     String   @default("India")
  serviceType String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([city])
  @@index([companyId, city])
}

model ProfessionalInquiry {
  id            String        @id @default(uuid())
  companyId     String
  clientName    String
  clientCompany String?
  email         String
  phone         String?
  requirement   String
  budget        String?
  timeline      String?
  status        InquiryStatus @default(NEW)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
}

model Booking {
  id              String               @id @default(uuid())
  companyId       String
  clientId        String
  serviceId       String?
  status          BookingStatus        @default(PENDING)
  scheduledAt     DateTime
  durationMinutes Int?
  amount          Decimal?             @db.Decimal(12, 2)
  notes           String?
  meetingLink     String?
  location        String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  escrowId        String?              @unique
  paymentId       String?
  paymentStatus   BookingPaymentStatus @default(PENDING)
  client          Company              @relation("ClientBookings", fields: [clientId], references: [id])
  company         Company              @relation("ProfessionalBookings", fields: [companyId], references: [id])
  escrow          Escrow?              @relation("BookingEscrow", fields: [escrowId], references: [id])
  service         ProfessionalService? @relation(fields: [serviceId], references: [id])
