{
  "name": "tradingo",
  "version": "1.0.0",
  "private": true,
  "description": "Tradingo monorepo",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "pnpm --filter @tradingo/api exec prisma migrate dev",
    "db:studio": "pnpm --filter @tradingo/api exec prisma studio",
    "db:generate": "pnpm --filter @tradingo/api exec prisma generate",
    "db:push": "pnpm --filter @tradingo/api exec prisma db push",
    "db:seed": "pnpm --filter @tradingo/api exec ts-node prisma/seed.ts",
    "db:seed:catalog": "pnpm exec ts-node --project prisma/seeds/tsconfig.json prisma/seeds/seed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "test:e2e": "pnpm --filter @tradingo/web test:e2e",
    "test:e2e:ui": "pnpm --filter @tradingo/web test:e2e:ui",
    "test:e2e:report": "pnpm --filter @tradingo/web test:e2e:report",
    "docker:build": "docker compose -f docker-compose.prod.yml build",
    "docker:up:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:down:prod": "docker compose -f docker-compose.prod.yml down",
    "docker:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "analyze": "ANALYZE=true pnpm --filter @tradingo/web build",
    "k6:smoke": "k6 run ops/load-testing/smoke-test.js",
    "k6:load": "k6 run ops/load-testing/load-test.js --env VUS=100 --env DURATION=5m",
    "k6:stress": "k6 run ops/load-testing/stress-test.js",
    "k6:auth": "k6 run ops/load-testing/auth-load-test.js --env VUS=50"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
