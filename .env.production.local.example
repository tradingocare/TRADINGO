# ============================================
# TRADINGO — Production Secrets Reference
# ============================================
# SCHEMA ONLY — variable names, comments and documentation.
# No real values. Copy to `.env.production.local` (gitignored) and fill in.
# Non-secret defaults live in the tracked template `.env.production`.
# Never commit real secrets. See docs/security/SECRETS-CHECKLIST.md.
#
# Legend:
#   [GENERATED]  - created automatically (Sprint 1); rotate at will
#   [FOUNDER]    - must be supplied by founder; boot guard FATAL if missing
#   [OPTIONAL]   - feature-gated; safe to leave empty
# ============================================

# ── App ──
NODE_ENV=
PORT=
FRONTEND_URL=
API_URL=
LOG_LEVEL=

# ── Frontend (Next.js public build vars) ──
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_RAZORPAY_KEY_ID=          # [FOUNDER] live publishable key
NEXT_PUBLIC_SENTRY_DSN=               # [OPTIONAL] public DSN (no secret token)

# ── Database ──
DATABASE_URL=                         # [GENERATED] postgresql://tradingo:<pass>@postgres:5432/tradingo
DIRECT_URL=                           # [GENERATED] postgresql://tradingo:<pass>@localhost:5432/tradingo (migrations)
POSTGRES_PASSWORD=                    # [GENERATED] must match DATABASE_URL password
PG_PASSWORD=                          # [GENERATED] backup scripts; must match POSTGRES_PASSWORD

# ── Redis ──
REDIS_URL=                            # [GENERATED] redis://:<pass>@redis:6379/0
REDIS_PASSWORD=                       # [GENERATED] must match REDIS_URL password

# ── JWT ──
JWT_SECRET=                           # [GENERATED] >=32 chars; boot guard fatal if placeholder
JWT_REFRESH_SECRET=                   # [GENERATED] >=32 chars; boot guard fatal if placeholder
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# ── AWS (SES email + S3 media/backups) ──
AWS_REGION=
AWS_ACCESS_KEY_ID=                    # [FOUNDER] IAM user w/ SES + S3 perms
AWS_SECRET_ACCESS_KEY=                # [FOUNDER]
AWS_BUCKET=
CLOUDFRONT_DOMAIN=                    # [OPTIONAL]

# ── Search / Analytics (Sprint 4 provisioning) ──
OPENSEARCH_URL=                       # [GENERATED] host:port of prod OpenSearch
OPENSEARCH_USERNAME=                  # [FOUNDER] set during provisioning
OPENSEARCH_PASSWORD=                  # [FOUNDER] set during provisioning
CLICKHOUSE_URL=                       # [OPTIONAL]
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# ── Email ──
EMAIL_FROM=                           # [FOUNDER] must match verified SES identity

# ── OAuth ──
GOOGLE_CLIENT_ID=                     # [FOUNDER]
GOOGLE_CLIENT_SECRET=                 # [FOUNDER]
GOOGLE_CALLBACK_URL=
LINKEDIN_CLIENT_ID=                   # [OPTIONAL]
LINKEDIN_CLIENT_SECRET=               # [OPTIONAL]
LINKEDIN_CALLBACK_URL=
GOOGLE_MAPS_API_KEY=                  # [OPTIONAL]

# ── SMS ──
TWILIO_ACCOUNT_SID=                   # [OPTIONAL]
TWILIO_AUTH_TOKEN=                    # [OPTIONAL]
TWILIO_PHONE_NUMBER=                  # [OPTIONAL]
SMS_PROVIDER=

# ── Payments ──
RAZORPAY_KEY_ID=                      # [FOUNDER] live key; boot fatal with PAYMENT_MODE=live
RAZORPAY_KEY_SECRET=                  # [FOUNDER]
RAZORPAY_WEBHOOK_SECRET=              # [FOUNDER]
RAZORPAY_ACCOUNT_NUMBER=              # [OPTIONAL]
PAYMENT_MODE=                         # flip to live only after all 3 Razorpay keys set
STRIPE_PUBLISHABLE_KEY=               # [OPTIONAL]
STRIPE_SECRET_KEY=                    # [OPTIONAL]
STRIPE_WEBHOOK_SECRET=                # [OPTIONAL]

# ── Error Monitoring ──
SENTRY_DSN=                           # [FOUNDER] real project DSN; boot fatal if enabled+placeholder
SENTRY_ENABLED=                       # keep disabled until real DSN supplied

# ── AI ──
AI_VAULT_MASTER_KEY=                  # [GENERATED] 64 hex
AI_CACHE_ENABLED=
OPENAI_API_KEY=                       # [FOUNDER] at least one provider required for AI
OPENROUTER_API_KEY=                   # [FOUNDER]
GEMINI_API_KEY=                       # [FOUNDER]
GROQ_API_KEY=                         # [FOUNDER]
TAVILY_API_KEY=                       # [FOUNDER]
FIRECRAWL_API_KEY=                    # [FOUNDER]

# ── Backups (Sprint 4+ wiring) ──
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=
BACKUP_RETENTION_DAYS=
WAL_BACKUP_BUCKET=
WAL_RETENTION_HOURS=

# ── Monitoring ──
GRAFANA_ADMIN_PASSWORD=               # [GENERATED]
SLACK_WEBHOOK_URL=                    # [OPTIONAL] deploy/alert notifications
