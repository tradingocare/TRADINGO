{
  "title": "TRADINGO — Redis Cache",
  "uid": "tradingo-redis-dashboard",
  "tags": ["tradingo", "redis", "cache"],
  "schemaVersion": 37,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "title": "Cache Hits",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(redis_cache_hits_total[5m]))", "legendFormat": "Hits/s" }],
      "fieldConfig": { "defaults": { "unit": "rps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 100 }] } } }
    },
    {
      "title": "Cache Misses",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(rate(redis_cache_misses_total[5m]))", "legendFormat": "Misses/s" }],
      "fieldConfig": { "defaults": { "unit": "rps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 50 }] } } }
    },
    {
      "title": "Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(rate(redis_cache_hits_total[5m])) / (sum(rate(redis_cache_hits_total[5m])) + sum(rate(redis_cache_misses_total[5m])))", "legendFormat": "Hit Ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 0.8 }] } } }
    },
    {
      "title": "Cache Hits by Key Pattern",
      "type": "barchart",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "topk(10, sum by(key_pattern) (rate(redis_cache_hits_total[5m])))", "legendFormat": "{{key_pattern}}" }],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "title": "Cache Hit vs Miss Rate",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(redis_cache_hits_total[5m]))", "legendFormat": "Hits" },
        { "expr": "sum(rate(redis_cache_misses_total[5m]))", "legendFormat": "Misses" }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "title": "Cache Misses by Key Pattern",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "topk(10, sum by(key_pattern) (rate(redis_cache_misses_total[5m])))", "legendFormat": "{{key_pattern}}" }],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "title": "Redis Connected Clients",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "redis_connected_clients", "legendFormat": "Clients" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
