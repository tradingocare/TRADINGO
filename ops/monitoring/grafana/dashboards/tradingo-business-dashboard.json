{
  "uid": "tradingo-business",
  "title": "TRADINGO Business",
  "version": 3,
  "panels": [
    {
      "title": "Active Endpoints",
      "type": "graph",
      "targets": [{ "expr": "count(count by (path) (rate(api_http_requests_total[5m])))", "legendFormat": "endpoints" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "targets": [{ "expr": "sum(rate(api_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(api_http_requests_total[5m])) * 100", "legendFormat": "%" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "API Uptime",
      "type": "singlestat",
      "targets": [{ "expr": "avg(up{job=\"tradingo-api\"}) * 100" }],
      "format": "percent",
      "thresholds": "99,99.9",
      "colors": ["#d44", "#fa0", "#0a0"],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 }
    },
    {
      "title": "Request Rate",
      "type": "graph",
      "targets": [{ "expr": "job:http_requests_total:rate5m", "legendFormat": "req/s" }],
      "gridPos": { "h": 8, "w": 12, "x": 4, "y": 8 }
    }
  ]
}
