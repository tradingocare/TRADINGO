{
  "title": "TRADINGO — Database Performance",
  "uid": "tradingo-database-dashboard",
  "tags": ["tradingo", "database"],
  "schemaVersion": 37,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "title": "Query Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(prisma_queries_total[5m]))", "legendFormat": "Queries/s" }],
      "fieldConfig": { "defaults": { "unit": "rps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 2000 }] } } }
    },
    {
      "title": "P95 Query Latency",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(prisma_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.5 }] } } }
    },
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "legendFormat": "Connections" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 80 }] } } }
    },
    {
      "title": "Queries by Model (top 10)",
      "type": "barchart",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "topk(10, sum by(model) (rate(prisma_queries_total[5m])))", "legendFormat": "{{model}}" }],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "title": "Query Latency P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(prisma_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(prisma_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(prisma_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Query Rate by Action",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum by(action) (rate(prisma_queries_total[5m]))", "legendFormat": "{{action}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "title": "Slow Queries (>500ms count)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "sum(rate(prisma_query_duration_seconds_bucket{le=\"0.5\"}[5m]))", "legendFormat": "Under 500ms" }],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    }
  ]
}
